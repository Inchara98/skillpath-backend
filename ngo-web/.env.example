# ngo-web — environment variables
#
# Copy to .env and fill in real values for local development:
#   cp .env.example .env

# Supabase project URL, e.g. https://abcxyz.supabase.co
VITE_SUPABASE_URL=

# Supabase "anon" / public key (Project Settings -> API -> anon public).
# Safe to expose in a client app — NEVER put the service_role key here,
# that one belongs only in the backend servers' own .env.
VITE_SUPABASE_ANON_KEY=
