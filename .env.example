# SkillPath / Bana Pele — environment variables
#
# This repo has 3 separate Node services, each deployed as its own Render
# Web Service. On Render, each service gets its OWN copy of these env vars
# set in its dashboard (Environment tab) — there is no single shared .env
# in production. Locally, you can run all 3 from one .env at the repo root
# since Node will just ignore vars a given service doesn't use.
#
# Copy this file to `.env` and fill in real values for local development:
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Shared by all 3 services — Supabase (Postgres) persistence
# ---------------------------------------------------------------------------
# Your Supabase project URL, e.g. https://abcxyz.supabase.co
SUPABASE_URL=
# Supabase "service_role" key (Project Settings -> API -> service_role).
# NOT the anon/public key — this needs write access and bypasses RLS.
SUPABASE_SERVICE_KEY=

# If both of the above are left blank, all 3 services still run fine —
# they just fall back to in-memory storage that resets on every restart.

# ---------------------------------------------------------------------------
# demo-bap-server.js (buyer/BAP side) — local default port 3001
# ---------------------------------------------------------------------------
# Where demo-bap sends outgoing Beckn calls (discover/select/init/confirm).
# In production this points at the onix-bap gateway; locally the code
# defaults to http://onix-bap:8081/bap/caller if unset.
ONIX_BAP_CALLER=

# ---------------------------------------------------------------------------
# course-bpp-server.js (seller/BPP side) — local default port 3002
# ---------------------------------------------------------------------------
# Where course-bpp sends on_discover/on_select/on_init/on_confirm callbacks.
# Defaults to http://onix-bpp:8082/bpp/caller if unset.
ONIX_BPP_CALLER=

# ---------------------------------------------------------------------------
# whatsapp-bot-server.js — local default port 4000
# ---------------------------------------------------------------------------
# Base URL of the demo-bap service this bot talks to (the same 5 endpoints
# the Flutter app uses). Defaults to http://localhost:3001 if unset —
# in production, set this to https://skillpath-demo-bap.onrender.com
BAP_BASE_URL=

# Meta WhatsApp Business Cloud API credentials (developers.facebook.com).
WA_TOKEN=
WA_PHONE_NUMBER_ID=
# Any string you choose — must match what you enter in Meta's webhook
# verification setup. Has a working default, but change it for real use.
WA_VERIFY_TOKEN=bana-enroll-verify-2026

# The admin's own WhatsApp number (no "+", digits only, e.g. 91XXXXXXXXXX).
# Receives centre-setup/support-request notifications and can reply
# "assign me <id>" / "forward <id>".
ADMIN_PHONE=

# Anthropic API key — powers natural-language Q&A and the AI-first
# conversational router (classifyConversation). If left blank, the bot
# automatically falls back to the old menu-driven (type 1/2/3/4) flow —
# it never goes silent, just less natural.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Port (Render sets this automatically — you normally don't need to set it
# yourself, even locally, unless you want to run more than one service on
# your machine at once and avoid clashing on the same default port)
# ---------------------------------------------------------------------------
# PORT=3001
